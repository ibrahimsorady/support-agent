# Copy this file to .env and fill in your key:
#   cp .env.example .env
OPENAI_API_KEY=sk-your-key-here

# Optional overrides (defaults shown):
# CHAT_MODEL=gpt-5-mini
# EMBED_MODEL=text-embedding-3-small
# TOP_K=3

# Vector store: "numpy" (default, file-based) or "pgvector" (Postgres)
# VECTOR_BACKEND=numpy
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/telco

# Guardrails: "true" (default, on) or "false" (off)
ENABLE_GROUNDING_GUARD=true